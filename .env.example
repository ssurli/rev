# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-...

# Revolut Open Banking
REVOLUT_CLIENT_ID=
REVOLUT_CLIENT_SECRET=
REVOLUT_SANDBOX=true

# NewsAPI (https://newsapi.org — free tier: 100 req/day)
NEWSAPI_KEY=

# FRED API — Federal Reserve Economic Data (free key: fred.stlouisfed.org/docs/api/api_key.html)
# Fornisce: Fed Funds Rate, CPI, Unemployment, Treasury Yields, VIX, Consumer Sentiment
FRED_API_KEY=

# Trading mode: paper | live
TRADING_MODE=paper

# Risk / sizing (mirror revolut_invest_v3.html rules)
MAX_TRADE_EUR=50
MIN_PORTFOLIO_EUR=20
MAX_POSITION_PCT=20
MIN_CASH_PCT=15
STOP_LOSS_PCT=-15
TAKE_PROFIT_PCT=30
MAX_CRYPTO_PCT=15

# Assets to monitor (comma-separated yfinance tickers)
# Default comprende crypto, ETF, commodities e stock principali
ASSETS=BTC-USD,ETH-USD,SOL-USD,VOO,QQQ,TLT,GLD,SLV,CL=F,AAPL,MSFT,NVDA,TSLA,AMZN,META,JPM,BAC

# Cycle interval in minutes
CYCLE_INTERVAL_MINUTES=30

# Paths
DB_PATH=./data/bot.sqlite
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# v2 — trading autonomo piccoli capitali
# ---------------------------------------------------------------------------

# Revolut X (crypto) — chiave privata Ed25519 FUORI dal repo, chmod 600
REVOLUT_X_PRIVATE_KEY_PATH=

# Alpaca (stock/ETF frazionari — opzionale, vuoto = modulo disattivo)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Cost gate: blocca ordini se (fee + ½spread) > X% del size
COST_GATE_MAX_PCT=0.40
TAKER_FEE_PCT=0.09
DEFAULT_SPREAD_PCT=0.20
MIN_ORDER_EUR=10

# Anti-overtrading
TRADE_COOLDOWN_MINUTES=240
MAX_TRADES_PER_DAY=6
MAX_DAILY_TURNOVER_PCT=30

# Risk per trade (perdita max a stop, % equity) + moltiplicatori ATR
RISK_PER_TRADE_PCT=1.0
ATR_STOP_MULT=2.0
ATR_TP_MULT=3.0
MAX_CASH_PER_TRADE_PCT=30

# Circuit-breaker drawdown (flat & halt, sblocco manuale)
MAX_DRAWDOWN_HALT_PCT=10

# LIVE: doppia conferma (questa env + flag --confirm-live) e hard-cap capitale
LIVE_TRADING_CONFIRM=
LIVE_MAX_CAPITAL_EUR=500

# Alert email SMTP (Zimbra) — vuoto = disabilitato
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Metodo fiscale Quadro RT (coerente tra gli anni)
TAX_LOT_METHOD=LIFO
